# Paste your Airtable form's share link here, then copy this file to .env.local (and add the same
# variable in your hosting provider's environment settings before building).
NEXT_PUBLIC_APPLY_URL=https://airtable.com/your-form-id

# The Academy's email address (defaults to academy@codecraftie.com).
NEXT_PUBLIC_ACADEMY_EMAIL=

# Bank transfer details shown in "How to apply and pay".
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_ACCOUNT_NAME=
NEXT_PUBLIC_ACCOUNT_NUMBER=

# Optional: Paystack payment page links, one per option. When set, students can pay online.
NEXT_PUBLIC_PAY_FOUNDATION_URL=
NEXT_PUBLIC_PAY_CAREER_LAUNCH_URL=
NEXT_PUBLIC_PAY_PRO_URL=
